# Copy this file to .env and fill in the values. .env is git-ignored.

# Required. Signing key for the JWT access tokens, at least 32 characters.
# The app refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional. SQLAlchemy database URL. Default: a SQLite file in the working directory.
# DATABASE_URL=sqlite:///./expenses.db

# Optional. Lifetime of an access token in minutes. Default: 30.
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional. bcrypt cost factor, 4 to 16. Default: 12. Lower it only for tests.
# BCRYPT_ROUNDS=12

# Optional. Comma-separated origins allowed by CORS. Default: empty, CORS off.
# CORS_ORIGINS=http://localhost:5173
